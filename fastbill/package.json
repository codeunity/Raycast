{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "fastbill",
  "title": "Fastbill",
  "description": "View Fastbill invoices, finances and more.",
  "icon": "extension-icon.png",
  "author": "Michi-2124",
  "owner": "codeunity-gmbh",
  "categories": [
    "Finance"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "invoices",
      "title": "Invoices",
      "description": "Show all invoices.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "email",
      "title": "Email",
      "description": "Email of your fastbill account.",
      "type": "textfield",
      "required": true
    },
    {
      "name": "apiKey",
      "title": "API Key",
      "description": "API Key of your fastbill account.",
      "type": "password",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1",
    "@raycast/utils": "^2.3.1",
    "es-toolkit": "^1.52.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
